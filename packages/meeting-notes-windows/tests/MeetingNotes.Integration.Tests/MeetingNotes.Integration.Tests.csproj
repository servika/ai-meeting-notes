<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Portable on purpose: the integration flows drive Core against a stub
         whisper CLI and a stub summary server, so they run on the macOS dev
         machine as well as on Windows CI. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MeetingNotes.Core\MeetingNotes.Core.csproj" />
  </ItemGroup>

</Project>