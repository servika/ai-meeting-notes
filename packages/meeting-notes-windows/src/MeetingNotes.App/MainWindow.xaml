<ui:FluentWindow x:Class="MeetingNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI Meeting Notes" Height="720" Width="1120"
        Icon="app.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Monochrome glyph icons via the Windows icon font (macOS SF-Symbols vibe,
             no dependency on a specific WPF-UI SymbolRegular enum name). -->
        <Grid.Resources>
            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <ui:TitleBar Grid.Row="0" Title="AI Meeting Notes" />

        <!-- Content grid: the sidebar/detail split, with the Settings overlay on top -->
        <Grid Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===================== SIDEBAR ===================== -->
                <!-- macOS layout: meeting list fills the top, the record panel is
                     pinned at the bottom, with a settings/version footer. -->
                <DockPanel Grid.Column="0" Margin="12,4,8,12">

                    <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top"
                                PlaceholderText="Search meetings…"
                                TextChanged="OnSearchChanged" />

                    <!-- Bottom: record panel + settings/version footer -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="0,10,0,10" />

                        <!-- Meeting detected nudge -->
                        <Border x:Name="DetectedBanner" Visibility="Collapsed"
                                Background="#1EFF8800" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🎙 Meeting detected" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Another app is using your microphone." FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Content="Start Recording" Margin="0,6,0,0"
                                           Appearance="Primary" Click="OnDetectedRecordClick"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Language (kept next to Record, like macOS) -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE774;"
                                       Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="LanguageBox" SelectedIndex="0" IsEditable="True"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="auto" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Ukrainian" />
                                <ComboBoxItem Content="Polish" />
                                <ComboBoxItem Content="German" />
                                <ComboBoxItem Content="French" />
                                <ComboBoxItem Content="Spanish" />
                                <ComboBoxItem Content="Italian" />
                                <ComboBoxItem Content="Portuguese" />
                                <ComboBoxItem Content="Dutch" />
                                <ComboBoxItem Content="Czech" />
                                <ComboBoxItem Content="Romanian" />
                                <ComboBoxItem Content="Swedish" />
                                <ComboBoxItem Content="Norwegian" />
                                <ComboBoxItem Content="Danish" />
                                <ComboBoxItem Content="Finnish" />
                                <ComboBoxItem Content="Hungarian" />
                                <ComboBoxItem Content="Turkish" />
                                <ComboBoxItem Content="Russian" />
                                <ComboBoxItem Content="Japanese" />
                                <ComboBoxItem Content="Korean" />
                                <ComboBoxItem Content="Chinese" />
                                <ComboBoxItem Content="Arabic" />
                                <ComboBoxItem Content="Hindi" />
                            </ComboBox>
                        </DockPanel>

                        <ui:Button x:Name="RecordButton" Content="● Record" Height="42" FontSize="15"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Appearance="Primary" Click="OnRecordClick" />

                        <TextBlock x:Name="StatusText" Margin="0,10,0,2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Idle." />

                        <!-- Progress with percentage + ETA -->
                        <Grid x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar x:Name="ProcessingProgress" Grid.Row="0" Height="4" Minimum="0" Maximum="100" />
                            <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Left" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ProgressEta" DockPanel.Dock="Right" FontSize="11"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ProgressElapsed" FontSize="11" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                            <ui:Button x:Name="CancelButton" Grid.Row="2" Content="Stop processing" Margin="0,4,0,0"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       Click="OnCancelClick" />
                        </Grid>

                        <!-- Input level meters -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="System" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="SystemLevel" Grid.Column="1" Height="6" Minimum="0" Maximum="1" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mic" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="MicLevel" Grid.Column="1" Height="6" Minimum="0" Maximum="1" />
                        </Grid>

                        <!-- Settings + version footer -->
                        <DockPanel Margin="0,12,0,0">
                            <ui:Button DockPanel.Dock="Left" Click="OnOpenSettings" Appearance="Secondary">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,6,0" />
                                    <TextBlock Text="Settings" />
                                </StackPanel>
                            </ui:Button>
                            <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Text="v0.0.0"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Fill: meeting list with rich rows -->
                    <ListBox x:Name="MeetingList" Margin="0,8,0,0"
                             SelectionChanged="OnMeetingSelected"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Text="&#xE720;" FontSize="16" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   FontWeight="SemiBold" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Date, StringFormat='{}{0:MMM d, HH:mm}'}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Re-generate" Click="OnRegenerate" />
                                <MenuItem Header="Trim recording…" Click="OnTrimRecording" />
                                <MenuItem Header="Rename…" Click="OnRename" />
                                <Separator />
                                <MenuItem Header="Delete" Click="OnDelete" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>

                <!-- ===================== DETAIL ===================== -->
                <Grid Grid.Column="1" Margin="4,4,12,12">
                    <DockPanel x:Name="DetailContent" Visibility="Collapsed">
                        <!-- Update banner -->
                        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                                Background="#1E3C78DC" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <DockPanel>
                                <ui:Button Content="✕" DockPanel.Dock="Right" Click="OnDismissUpdate"
                                           Background="Transparent" Padding="4" />
                                <ui:Button x:Name="UpdateDownloadBtn" Content="Download" DockPanel.Dock="Right"
                                           Margin="8,0,4,0" Appearance="Primary" Click="OnDownloadUpdate" />
                                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" FontSize="12" />
                            </DockPanel>
                        </Border>

                        <!-- Outdated version banner -->
                        <Border x:Name="OutdatedBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                                Background="#1EFF8800" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <DockPanel>
                                <ui:Button Content="Re-generate" DockPanel.Dock="Right" Margin="8,0,0,0"
                                           Click="OnRegenerate" />
                                <TextBlock x:Name="OutdatedText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                            </DockPanel>
                        </Border>

                        <!-- Title + icon toolbar -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <ui:Button ToolTip="Copy note to clipboard" Click="OnCopyNote">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="16" />
                                </ui:Button>
                                <ui:Button ToolTip="Re-transcribe &amp; re-summarize" Margin="6,0,0,0" Click="OnRegenerate">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="16" />
                                </ui:Button>
                                <ui:Button ToolTip="Trim the end off a forgotten recording" Margin="6,0,0,0" Click="OnTrimRecording">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" FontSize="16" />
                                </ui:Button>
                                <ui:Button ToolTip="Rename" Margin="6,0,0,0" Click="OnRename">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;" FontSize="16" />
                                </ui:Button>
                                <ui:Button ToolTip="Delete meeting" Margin="6,0,0,0" Click="OnDelete">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="16" />
                                </ui:Button>
                            </StackPanel>
                            <TextBlock x:Name="DetailTitle" Text="" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <TextBlock x:Name="DurationLabel" DockPanel.Dock="Top" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- Audio player -->
                        <Border x:Name="PlayerPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8">
                            <ui:Card Padding="10">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <ui:Button x:Name="PlayerRestart" Content="⏮" Click="OnPlayerRestart"
                                                       Padding="4" Background="Transparent" ToolTip="Restart" />
                                            <ui:Button x:Name="PlayerBack" Content="−15s" Click="OnPlayerBack"
                                                       Padding="4" Margin="4,0,0,0" Background="Transparent" ToolTip="Back 15s" />
                                            <ui:Button x:Name="PlayerPlayPause" Content="▶" Click="OnPlayerPlayPause"
                                                       Padding="6" Margin="4,0,0,0" FontSize="16" ToolTip="Play / Pause" />
                                            <ui:Button x:Name="PlayerForward" Content="+15s" Click="OnPlayerForward"
                                                       Padding="4" Margin="4,0,0,0" Background="Transparent" ToolTip="Forward 15s" />
                                        </StackPanel>
                                        <ComboBox x:Name="SpeedPicker" DockPanel.Dock="Right" Width="70"
                                                  SelectionChanged="OnSpeedChanged" Margin="8,0,0,0" />
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="PlayerTime" DockPanel.Dock="Left" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="PlayerDuration" DockPanel.Dock="Right" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Slider x:Name="PlayerSlider" Margin="8,0"
                                                ValueChanged="OnPlayerSliderChanged"
                                                Minimum="0" Maximum="100" SmallChange="1" LargeChange="15" />
                                    </DockPanel>
                                </StackPanel>
                            </ui:Card>
                        </Border>

                        <!-- Tabbed content: Summary / Transcript / Markdown -->
                        <TabControl x:Name="DetailTabs" SelectionChanged="OnDetailTabChanged">
                            <TabItem Header="Summary">
                                <ui:Card Padding="0">
                                    <ui:TextBox x:Name="SummaryBox" IsReadOnly="True"
                                                VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                FontFamily="Segoe UI" AcceptsReturn="True"
                                                BorderThickness="0" Background="Transparent" />
                                </ui:Card>
                            </TabItem>
                            <TabItem Header="Transcript">
                                <ui:Card Padding="0">
                                    <ui:TextBox x:Name="TranscriptBox" IsReadOnly="True"
                                                VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                FontFamily="Segoe UI" AcceptsReturn="True"
                                                BorderThickness="0" Background="Transparent" />
                                </ui:Card>
                            </TabItem>
                            <TabItem Header="Markdown">
                                <ui:Card Padding="0">
                                    <ui:TextBox x:Name="DetailBox" IsReadOnly="True"
                                                VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                FontFamily="Cascadia Mono, Consolas" AcceptsReturn="True"
                                                BorderThickness="0" Background="Transparent" />
                                </ui:Card>
                            </TabItem>
                        </TabControl>
                    </DockPanel>

                    <!-- Empty state when no meeting is selected -->
                    <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE720;"
                                   FontSize="46" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No meeting selected" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,12,0,2" HorizontalAlignment="Center" />
                        <TextBlock Text="Record a meeting, or pick one from the list."
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===================== SETTINGS OVERLAY ===================== -->
            <Border x:Name="SettingsOverlay" Visibility="Collapsed" Background="#99000000">
                <ui:Card Width="540" MaxHeight="620" Padding="0"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel Margin="18">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right" Content="✕" Appearance="Secondary"
                                       Padding="6" Click="OnCloseSettings" />
                            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11">
                                <Hyperlink NavigateUri="https://github.com/servika/ai-meeting-notes/blob/main/THIRD-PARTY-NOTICES.md"
                                           RequestNavigate="OnOpenLink">Credits &amp; licenses</Hyperlink>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Close" Click="OnCloseSettings" />
                                <ui:Button Content="Save settings" Appearance="Primary" Margin="8,0,0,0"
                                           Click="OnSaveSettings" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,10,0">
                                <DockPanel>
                                    <ui:Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OnBrowseVault" />
                                    <TextBlock Text="Notes folder" VerticalAlignment="Center" />
                                </DockPanel>
                                <ui:TextBox x:Name="VaultBox" PlaceholderText="Folder where notes are saved" Margin="0,2,0,0" />

                                <TextBlock Text="Whisper model (.bin)" Margin="0,10,0,2" />
                                <DockPanel>
                                    <ui:Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OnBrowseModel" />
                                    <ui:TextBox x:Name="ModelBox" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <ui:Button x:Name="DownloadButton" Content="Download" DockPanel.Dock="Right"
                                               Margin="6,0,0,0" Click="OnDownloadModel" />
                                    <ComboBox x:Name="ModelPicker" />
                                </DockPanel>
                                <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="1" Margin="0,4,0,0" />

                                <TextBlock Text="whisper-cli.exe" Margin="0,10,0,2" />
                                <DockPanel>
                                    <ui:Button Content="Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OnBrowseWhisper" />
                                    <ui:TextBox x:Name="WhisperBox" />
                                </DockPanel>

                                <TextBlock Text="Microphone" Margin="0,10,0,2" />
                                <ComboBox x:Name="MicPicker" DisplayMemberPath="Name" SelectedValuePath="Id" HorizontalAlignment="Stretch" />

                                <CheckBox x:Name="TranscribeCheck" Content="Transcribe" IsChecked="True" Margin="0,10,0,0" />
                                <CheckBox x:Name="SummarizeCheck" Content="Summarize" IsChecked="True" />

                                <TextBlock Text="Summary engine" Margin="0,10,0,2" />
                                <ComboBox x:Name="EngineBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="None" />
                                    <ComboBoxItem Content="Ollama" />
                                    <ComboBoxItem Content="Claude" />
                                </ComboBox>
                                <TextBlock Text="Ollama URL / model" Margin="0,10,0,2" />
                                <ui:TextBox x:Name="OllamaUrlBox" Text="http://localhost:11434" />
                                <ui:TextBox x:Name="OllamaModelBox" Text="qwen2.5:7b" Margin="0,4,0,0" />
                                <TextBlock Text="Claude API key / model" Margin="0,10,0,2" />
                                <PasswordBox x:Name="ClaudeKeyBox" />
                                <ui:TextBox x:Name="ClaudeModelBox" Text="claude-opus-4-8" Margin="0,4,0,0" />

                                <TextBlock Text="Audio after transcription" Margin="0,10,0,2" />
                                <ComboBox x:Name="AudioRetentionBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Keep original (WAV)" />
                                    <ComboBoxItem Content="Compress (M4A)" />
                                    <ComboBoxItem Content="Delete audio" />
                                </ComboBox>

                                <CheckBox x:Name="AutoStopCheck" Content="Auto-stop forgotten recordings" IsChecked="True" Margin="0,10,0,0" />
                                <DockPanel Margin="20,2,0,0">
                                    <TextBlock Text="After silence (min):" VerticalAlignment="Center" FontSize="12" />
                                    <ui:TextBox x:Name="AutoStopMinutesBox" Text="5" Width="50" Margin="6,0,0,0" />
                                </DockPanel>
                                <CheckBox x:Name="DetectMeetingsCheck" Content="Detect meetings (mic usage)" IsChecked="True" Margin="0,6,0,0" />

                                <TextBlock Text="Summary prompt" Margin="0,10,0,2" />
                                <ui:TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                            Height="80" VerticalScrollBarVisibility="Auto"
                                            PlaceholderText="Default prompt (leave empty to use built-in)" />

                                <TextBlock Text="Theme" Margin="0,10,0,2" />
                                <ComboBox x:Name="ThemeBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem Content="System" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </ui:Card>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>